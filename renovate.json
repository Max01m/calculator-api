{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Asia/Dushanbe",
  "schedule": ["before 6am on monday"],
  "packageRules": [
    {
      "description": "Python-зависимости из requirements.txt — минорные и patch-обновления автоматически, major — отдельным MR/PR на ручную проверку",
      "matchManagers": ["pip_requirements"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": false,
      "commitMessagePrefix": "fix(deps):"
    },
    {
      "description": "Major-обновления Python-зависимостей — только предупреждение, без автослияния",
      "matchManagers": ["pip_requirements"],
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "needs-review"],
      "commitMessagePrefix": "feat(deps)!:"
    },
    {
      "description": "Базовый образ Docker (python:3.12-slim) — отдельный MR/PR при выходе новой версии",
      "matchManagers": ["dockerfile"],
      "commitMessagePrefix": "fix(docker):",
      "labels": ["docker", "base-image"]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  }
}
